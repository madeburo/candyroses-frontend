# Candy Roses storefront
# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://candyrosesshop.com
# Internal API address for server-side rendering and the /api rewrite
API_INTERNAL_URL=http://127.0.0.1:4000
# Public media base URL (must match the API MEDIA_PUBLIC_URL)
NEXT_PUBLIC_MEDIA_URL=https://api.candyrosesshop.com/uploads
PORT=3000
# Store timezone for dates
NEXT_PUBLIC_STORE_TIMEZONE=America/New_York
